{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/signin.html",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/:path+",
      "destination": "/app.html"
    }
  ]
}
