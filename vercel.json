{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/signin",
      "permanent": false
    },
    {
      "source": "/signin.html",
      "destination": "/signin",
      "permanent": false
    },
    {
      "source": "/signup.html",
      "destination": "/signup",
      "permanent": false
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/pos.html",
      "destination": "/new-wash",
      "permanent": false
    },
    {
      "source": "/pos",
      "destination": "/new-wash",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/signin",
      "destination": "/app.html"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/:path+",
      "destination": "/app.html"
    }
  ]
}
