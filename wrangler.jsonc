{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "washpilot-management",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/signin",
      "/signin/*",
      "/signup",
      "/signup/*",
      "/vendo-management",
      "/vendo-management/*",
      "/dashboard",
      "/dashboard/*",
      "/new-wash",
      "/new-wash/*",
      "/service-queue",
      "/service-queue/*",
      "/transactions",
      "/transactions/*",
      "/customers",
      "/customers/*",
      "/booking",
      "/booking/*",
      "/bookings",
      "/bookings/*",
      "/facility-listing",
      "/facility-listing/*",
      "/services-pricing",
      "/services-pricing/*",
      "/add-on-analytics",
      "/add-on-analytics/*",
      "/employees",
      "/employees/*",
      "/expenses",
      "/expenses/*",
      "/reports",
      "/reports/*",
      "/inventory",
      "/inventory/*",
      "/branches",
      "/branches/*",
      "/loyalty-packages",
      "/loyalty-packages/*",
      "/service-recipes",
      "/service-recipes/*",
      "/shift-reconciliation",
      "/shift-reconciliation/*",
      "/subscription-billing",
      "/subscription-billing/*",
      "/business-management",
      "/business-management/*",
      "/platform/overview",
      "/platform/overview/*",
      "/platform/businesses",
      "/platform/businesses/*",
      "/platform/billing-revenue",
      "/platform/billing-revenue/*",
      "/features",
      "/features/*",
      "/businesses",
      "/businesses/*",
      "/business",
      "/business/*",
      "/how-it-works",
      "/how-it-works/*",
      "/pricing",
      "/pricing/*",
      "/about",
      "/about/*",
      "/faq",
      "/faq/*",
      "/contact",
      "/contact/*",
      "/facility/*",
      "/book/*",
      "/login",
      "/signin.html",
      "/signup.html",
      "/forgot",
      "/forgot.html",
      "/dashboard.html",
      "/pos.html",
      "/pos",
      "/home.html",
      "/index.html",
      "/app.html"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
